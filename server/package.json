    "electron": "^43.2.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "bootstrap": "^5.3.8",
    "ejs": "^6.0.1",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "socket.io-client": "^4.8.3"
